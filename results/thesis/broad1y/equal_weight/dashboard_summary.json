{
  "perspective_version": "5.5.1",
  "tables": {
    "positions": {
      "schema": {
        "symbol": "string",
        "qty": "float",
        "last": "float",
        "value": "float"
      },
      "index": "symbol"
    },
    "equity": {
      "schema": {
        "date": "string",
        "equity": "float"
      },
      "index": "date"
    },
    "fills": {
      "schema": {
        "ts": "string",
        "symbol": "string",
        "side": "string",
        "qty": "float",
        "price": "float"
      },
      "index": null
    },
    "meta": {
      "schema": {
        "key": "string",
        "value": "string"
      },
      "index": "key"
    }
  },
  "update_path": "Arrow IPC bytes (typed from contracts schemas), not list-of-dicts JSON",
  "row_semantics": "whole-row: every schema column is sent for every row, so a key missing from a row nulls that cell; equity date keys are normalised to YYYY-MM-DD",
  "security": {
    "authentication": "none",
    "websocket_origin_policy": "same-origin only (Origin host:port must equal Host; loopback hosts only when bound to loopback) plus explicit --allow-origin entries; clients sending no Origin header (non-browser) are accepted",
    "default_bind_host": "127.0.0.1"
  },
  "npm_packages_used_by_static_index_html": {
