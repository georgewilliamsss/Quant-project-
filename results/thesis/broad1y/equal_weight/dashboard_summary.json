    "@perspective-dev/viewer-datagrid": "5.5.1",
    "source_file": "quantstack/dashboard/static/index.html",
    "all_pinned_to_perspective_python": true,
    "note": "read from the page's jsdelivr URLs; renamed from @finos/perspective* upstream -- see the module docstring in quantstack/dashboard/server.py"
  },
  "wire_selftest": {
